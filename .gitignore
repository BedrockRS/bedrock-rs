# Build output
/target/

# Python bytecode from the data scripts
__pycache__/

# Server runtime files: created when the server runs, never committed.
# Plugins and the start scripts in server/ are tracked.
/server/bedrockrs.toml
/server/ops.json
/server/keys/
/server/worlds/*
!/server/worlds/.gitkeep
*.pem

# The same files, from running the server in the repository root by mistake.
/bedrockrs.toml
/ops.json
/keys/
/worlds/
/plugins/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
